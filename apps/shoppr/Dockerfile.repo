FROM rust:1.88-bookworm AS builder

WORKDIR /workspace
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_HTTP_TIMEOUT=600
ENV CARGO_NET_RETRY=10
ENV CARGO_TARGET_DIR=/tmp/cargo-target

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/" \
    && git config --global --add url."https://github.com/".insteadOf "git@github.com:" \
    && git config --global --add url."https://github.com/worka-ai/".insteadOf "ssh://git@github.com/worka-ai/"

COPY . .

RUN sh apps/shoppr/scripts/prepare-local-dev.sh

WORKDIR /workspace/apps/shoppr

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/cargo-target \
    cargo build --locked -p shoppr --release \
    && cp /tmp/cargo-target/release/shoppr /workspace/shoppr

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        netcat-openbsd \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/apps/shoppr

COPY --from=builder /workspace/shoppr /usr/local/bin/shoppr
COPY --from=builder /workspace/apps /app/apps
COPY apps/shoppr/docker/entrypoint.sh /usr/local/bin/shoppr-entrypoint

RUN chmod +x /usr/local/bin/shoppr-entrypoint

ENTRYPOINT ["shoppr-entrypoint"]
